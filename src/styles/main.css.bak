:root {
  /* Colors */
  --primary: #635dff;
  --primary-hover: #5046e5;
  --primary-light: #f0efff;
  --text: #1e1e1e;
  --text-secondary: #6c6c6c;
  --text-muted: #9ca3af;
  --surface: #ffffff;
  --surface-hover: #f5f5f5;
  --background: #f0f0f0;
  --border: #e3e3e3;
  --border-focus: #635dff;
  --error: #d00e17;
  --error-bg: #fef1f2;
  --success: #13a688;
  --success-light: #e6f7f4;
  
  /* Spacing */
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-2xl: 48px;
  
  /* Border Radius */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  
  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 4px 16px rgba(0, 0, 0, 0.12);
  
  /* Transitions */
  --transition: all 0.2s ease;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background: var(--background);
  color: var(--text);
  line-height: 1.5;
}

.app {
  min-height: 100vh;
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

/* Screen Selector */
.screen-selector {
  background: var(--surface);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  max-width: 600px;
  margin: 0 auto;
  width: 100%;
}

.screen-selector-title {
  font-weight: 600;
  margin-bottom: var(--space-md);
  font-size: 0.875rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.screen-selector-list {
  display: flex;
  gap: var(--space-sm);
}

.screen-selector-button {
  flex: 1;
  padding: var(--space-sm) var(--space-md);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s;
}

.screen-selector-button:hover {
  background: var(--surface-hover);
}

.screen-selector-button.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

/* Container & Card */
.container {
  max-width: 450px;
  margin: 0 auto;
  width: 100%;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  width: 100%;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.card-header {
  padding: var(--space-xl) var(--space-xl) var(--space-lg);
  border-bottom: 1px solid var(--border);
  text-align: center;
}

.card-logo {
  display: flex;
  justify-content: center;
  margin-bottom: var(--space-md);
  font-size: 2rem;
  font-weight: 700;
  color: var(--primary);
}

.card-title,
.card-header h1 {
  mForm Elements */
.form-group {
  margin-bottom: var(--space-lg);
}

.form-label {
  display: block;
  margin-bottom: var(--space-sm);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text);
}

.form-input,
.input {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: 1rem;
  font-family: inherit;
  color: var(--text);
  background: var(--surface);
  transition: var(--transition);
  box-sizing: border-box;
}

.form-input:hover,
.input:hover {
  border-color: var(--text-secondary);
}

.form-input:focus,
.input:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px rgba(99, 93, 255, 0.1);
}

.form-input:disabled,
.input:disabled {
  background: var(--surface-hover);
  color: var(--text-muted);
  cursor: not-allowed;
  opacity: 0.6;
}

.form-input.error,
.input--error,
.input.error {
  border-s */
.button,
.button-primary,
.button-secondary {
  padding: 12px 24px;
  border: none;
  border-radius: var(--radius-md);
  font-size: 1rem;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: 100%;
  box-sizing: border-box;
}

.button-primary,
.button--primary {
  background: var(--primary);
  color: white;
  border: 1px solid var(--primary);
}

.button-primary:hover:not(:disabled),
.button--primary:hover:not(:disabled) {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
  box-shadow: var(--shadow-sm);
}

.button-primary:active:not(:disabled),
.button--primary:active:not(:disabled) {
  transform: translateY(1px);
}

.button-secondary,
.button--secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
}

.button-secondary:hover:not(:disabled),
.button--secondary:hover:not(:disabled) {
  background: var(--surface-hover);
  border-color: var(--text-secondary);
}

.button:disabled,
.button-primary:disabled,
.button-secondary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

.button--full-width {
  width: 100%;
}

.button--loading,
.button-loading {
  position: relative;
  pointer-events: none;
}

.button--loading::after,
.button-loading::after {
  content: '';
  position: absolute;
  width: 16px;
  height: 16px;
  border: 2px solid currentColor;
  border-radius: 50%;
  border-top-color: transparent;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }

.input--error {
  border-color: var(--error);
}

.input-helper-text {
  display: block;
  margin-top: var(--space-sm);
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.input-error-text {
  display: block;
  margin-top: var(--space-sm);
  font-size: 0,
.button-social {
  padding: 12px 16px;
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: var(--radius-md);
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  transition: var(--transition);
  color: var(--text);
  width: 100%;
}

.social-button:hover,
.button-social:hover {
  background: var(--surface-hover);
  border-color: var(--text-secondary);
  box-shadow: var(--shadow-sm
  gap: var(--space-sm);
}

.button--primary {
  background: var(--primary);
  color: white;
}

.button--primary:hover:not(:disabled) {
  background: var(--primary-hover);
}

.button--secondary {
  background: transparent;
  color: var(--primary);
  border: 1px solid var(--border);
}

.button--secondary:hover:not(:disabled) {
  background: var(--surface-hover);
}

.button--full-width {
  width: 100%;
}

.button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.button--loading {
  position: relative;
}

/* Error Message */
.error-message {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md);
  background: var(--error-bg);
  border: 1px solid var(--error);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-lg);
  color: var(--error);
  font-size: 0.875rem;
}

.error-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.error-message p,
.error-message ul {
  margin: 0;
}

/* Social Buttons */
.social-buttons {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.social-button {
  padding: var(--space-md);
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  transition: all 0.2s;
  transition: var(--transition);
}

.link:hover {
  text-decoration: underline;
  color: var(--primary-hover);
}

.link:focus {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

/* Utility Classes */
.text-center {
  text-align: center;
  margin-top: var(--space-lg);
}

.text-sm {
  font-size: 0.875rem;
}

.text-xs {
  font-size: 0.75rem;
}

.text-muted {
  color: var(--text-secondary);
}

.mt-sm { margin-top: var(--space-sm); }
.mt-md { margin-top: var(--space-md); }
.mt-lg { margin-top: var(--space-lg); }
.mb-sm { margin-bottom: var(--space-sm); }
.mb-md { margin-bottom: var(--space-md); }
.mb-lg { margin-bottom: var(--space-lg);   height: 20px;
}

/* Divider */
.divider {
  display: flex;
  align-items: center;
  text-align: center;
  margin: var(--space-lg) 0;
  color: var(--text-secondary);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid var(--border);
}

.divider::before {
  margin-right: var(--space-md);
}

.divider::after {
  margin-left: var(--space-md);
}

/* Links */
.link {
  color: var(--primary);
  text-decoration: none;
  font-size: 0.875rem;
}

.link:hover {
  text-decoration: underline;
}

.text-center {
  text-align: center;
  margin-top: var(--space-lg);
}